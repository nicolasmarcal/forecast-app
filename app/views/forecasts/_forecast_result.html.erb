<% if forecast_data.failure? %>
  <p style="color: red;"><%= forecast_data.error_message %></p>
<% else %>
  <h2>Result for: <%= forecast_data.zip_code %></h2>

  <% if forecast_data.from_cache %>
    <p style="color: green; font-weight: bold;">Cached result</p>
  <% end %>

  <p>Forecast data: <%= forecast_data.temperature %>°F</p>
  <p>Max: <%= forecast_data.high %>°F | Min: <%= forecast_data.low %>°F</p>
<% end %>